---
interface Props {
  title: string;
  description?: string;
  isArticle?: boolean;
  pubDate?: Date;
  author?: string;
  fullTitle?: string;
  ogTitle?: string;
}
const {
  title,
  description = "Practical AI and automation guidance for African SMEs, from LemonLogic Lab.",
  isArticle = false,
  pubDate,
  author = "Eric",
  fullTitle,
  ogTitle,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle || `${title} · LemonLogic Lab`}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://lemonlogiclab.com${Astro.url.pathname}`} />
  <!-- Open Graph / Social Media Meta Tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={ogTitle || title || "LemonLogic Lab"} />
<meta property="og:description" content={description || "Resources for Nigerian SMEs on invoicing, VAT, and getting paid on time."} />
<meta property="og:image" content="https://lemonlogiclab.com/images/og-image.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle || title || "LemonLogic Lab"} />
<meta name="twitter:description" content={description || "Resources for Nigerian SMEs on invoicing, VAT, and getting paid on time."} />
<meta name="twitter:image" content="https://lemonlogiclab.com/images/og-image.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  </noscript>
  <style is:global>
    :root {
      --ink: #232323;
      --paper: #FFFFFF;
      --lemon: #F5C518;
      --forest: #1F6F4A;
      --gridline: #E8E5DA;
      --gridline-dark: #D8D4C8;
      --muted: #78756C;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }
    h1, h2, h3 { font-family: 'Fraunces', serif; font-weight: 600; margin: 0; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }
    .btn {
      display: inline-block; background: var(--lemon); color: var(--ink);
      font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1rem;
      padding: 13px 24px; border-radius: 5px; border: 1.5px solid var(--ink);
      text-decoration: none; cursor: pointer;
    }
    .btn:hover { background: #e9b90f; }
    .btn-ghost {
      display: inline-block; background: transparent; color: var(--ink);
      font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.95rem;
      padding: 8px 0; text-decoration: none; border-bottom: 1.5px solid var(--ink);
    }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  </style>
  

  <!-- Cloudflare Web Analytics -->
  <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "f65fe9ea76d24bfbac0d3b2f4fdb2782"}'></script>
  <!-- End Cloudflare Web Analytics -->

  <script is:inline>
    (function () {
      function trackEvent(name) {
        try {
          var real = location.pathname + location.search + location.hash;
          history.pushState({}, '', '/e/' + name);
          history.replaceState({}, '', real);
        } catch (e) {}
      }
      window.lemonTrack = trackEvent;

      document.addEventListener('click', function (e) {
        var a = e.target.closest('a');
        if (!a) return;
        var href = a.getAttribute('href') || '';
        if (href.indexOf('/invoice-kit') === 0) {
          trackEvent('click-invoice-kit-link');
        } else if (href.indexOf('selar.com') !== -1) {
          trackEvent('click-selar-checkout');
        } else if (href.indexOf('wa.me') !== -1 || href.indexOf('whatsapp') !== -1) {
          trackEvent('click-whatsapp');
        } else if (href.indexOf('mailto:') === 0) {
          trackEvent('click-email');
        }
      });

      var scrollTracked = {};
      window.addEventListener('scroll', function () {
        var scrolled = (window.scrollY + window.innerHeight) / document.body.scrollHeight;
        if (scrolled > 0.75 && !scrollTracked['75']) {
          scrollTracked['75'] = true;
          trackEvent('scroll-75-' + location.pathname.replace(/\//g, '-'));
        }
      }, { passive: true });
    })();
  </script>

  
  <!-- Schema Markup for Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "LemonLogic Lab",
    "url": "https://lemonlogiclab.com",
    "logo": "https://lemonlogiclab.com/images/og-image.png",
    "description": "Practical AI and automation guidance for African SMEs",
    "parentOrganization": {
      "@type": "Organization",
      "name": "LemonLogic AI",
      "url": "https://lemonlogicai.com"
    }
  }
  </script>

  {isArticle && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": {
        "@type": "Person",
        "name": author
      },
      "publisher": {
        "@type": "Organization",
        "name": "LemonLogic Lab",
        "logo": {
          "@type": "ImageObject",
          "url": "https://lemonlogiclab.com/images/og-image.png"
        }
      },
      "datePublished": pubDate ? pubDate.toISOString() : undefined,
      "dateModified": pubDate ? pubDate.toISOString() : undefined,
      "image": "https://lemonlogiclab.com/images/og-image.png",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": Astro.url.href
      }
    })} />
  )}
  </head>
<body>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a href="/" class="wordmark">LemonLogic <span>Lab</span></a>
      <nav class="site-nav">
        <a href="/blog">Blog</a>
        <a href="/about">About</a>
        <a href="/invoice-kit">Get the Invoice Kit</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <span>LemonLogic Lab · practical AI &amp; automation for African SMEs</span>
      <nav class="footer-links">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
        <a href="/refund-policy">Refunds</a>
        <a href="/disclaimer">Disclaimer</a>
        <a href="/contact">Contact</a>
      </nav>
      <a href="https://lemonlogicai.com" class="btn-ghost" target="_blank" rel="noopener">Part of LemonLogic AI ↗</a>
    </div>
  </footer>

  <style>
    .site-header { padding: 26px 0; border-bottom: 1px solid var(--gridline); }
    .site-header__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .wordmark { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.05rem; text-decoration: none; }
    .wordmark span { color: var(--lemon); }
    .site-nav { display: flex; gap: 28px; align-items: center; }
    .site-nav a { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 0.95rem; text-decoration: none; color: var(--ink); }
    .site-nav a:last-child {
      background: var(--lemon); padding: 9px 16px; border-radius: 5px; border: 1.5px solid var(--ink); font-weight: 600;
    }
    .site-footer { padding: 36px 0 44px; border-top: 1px solid var(--gridline); margin-top: 80px; }
    .site-footer__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.88rem; color: var(--muted); }
        .footer-links { display: flex; gap: 18px; flex-wrap: wrap; }
    .footer-links a { color: var(--muted); text-decoration: none; font-size: 0.85rem; }
    .footer-links a:hover { color: var(--ink); text-decoration: underline; }
  </style>
</body>
</html>
