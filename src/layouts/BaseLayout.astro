---
interface Props {
  title: string;
  description?: string;
}
const { title, description = "Practical AI and automation guidance for African SMEs, from LemonLogic Lab." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · LemonLogic Lab</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={`https://lemonlogiclab.com${Astro.url.pathname}`} />
  <!-- Open Graph / Social Media Meta Tags -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url.href} />
<meta property="og:title" content={title || "LemonLogic Lab"} />
<meta property="og:description" content={description || "Resources for Nigerian SMEs on invoicing, VAT, and getting paid on time."} />
<meta property="og:image" content="https://lemonlogiclab.com/images/og-image.png" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title || "LemonLogic Lab"} />
<meta name="twitter:description" content={description || "Resources for Nigerian SMEs on invoicing, VAT, and getting paid on time."} />
<meta name="twitter:image" content="https://lemonlogiclab.com/images/og-image.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" media="print" onload="this.media='all'" />
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,600;1,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" />
  </noscript>
  <style is:global>
    :root {
      --ink: #232323;
      --paper: #FFFFFF;
      --lemon: #F5C518;
      --forest: #1F6F4A;
      --gridline: #E8E5DA;
      --gridline-dark: #D8D4C8;
      --muted: #78756C;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      font-family: 'Inter', sans-serif;
      color: var(--ink);
      background: var(--paper);
      line-height: 1.55;
    }
    a { color: inherit; }
    img { max-width: 100%; display: block; }
    h1, h2, h3 { font-family: 'Fraunces', serif; font-weight: 600; margin: 0; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 0 28px; }
    .btn {
      display: inline-block; background: var(--lemon); color: var(--ink);
      font-family: 'Inter', sans-serif; font-weight: 600; font-size: 1rem;
      padding: 13px 24px; border-radius: 5px; border: 1.5px solid var(--ink);
      text-decoration: none; cursor: pointer;
    }
    .btn:hover { background: #e9b90f; }
    .btn-ghost {
      display: inline-block; background: transparent; color: var(--ink);
      font-family: 'Inter', sans-serif; font-weight: 600; font-size: 0.95rem;
      padding: 8px 0; text-decoration: none; border-bottom: 1.5px solid var(--ink);
    }
    a:focus-visible, button:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  </style>

  <!-- Schema Markup for Organization -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "LemonLogic Lab",
    "url": "https://lemonlogiclab.com",
    "logo": "https://lemonlogiclab.com/images/og-image.png",
    "description": "Practical AI and automation guidance for African SMEs"
  }
  </script>
  </head>
<body>
  <header class="site-header">
    <div class="wrap site-header__inner">
      <a href="/" class="wordmark">LemonLogic <span>Lab</span></a>
      <nav class="site-nav">
        <a href="/blog">Blog</a>
        <a href="/invoice-kit">Get the Invoice Kit</a>
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap site-footer__inner">
      <span>LemonLogic Lab · practical AI &amp; automation for African SMEs</span>
      <a href="https://lemonlogicai.com" class="btn-ghost">lemonlogicai.com</a>
    </div>
  </footer>

  <style>
    .site-header { padding: 26px 0; border-bottom: 1px solid var(--gridline); }
    .site-header__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; }
    .wordmark { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 1.05rem; text-decoration: none; }
    .wordmark span { color: var(--lemon); }
    .site-nav { display: flex; gap: 28px; align-items: center; }
    .site-nav a { font-family: 'Inter', sans-serif; font-weight: 500; font-size: 0.95rem; text-decoration: none; color: var(--ink); }
    .site-nav a:last-child {
      background: var(--lemon); padding: 9px 16px; border-radius: 5px; border: 1.5px solid var(--ink); font-weight: 600;
    }
    .site-footer { padding: 36px 0 44px; border-top: 1px solid var(--gridline); margin-top: 80px; }
    .site-footer__inner { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; font-size: 0.88rem; color: var(--muted); }
  </style>
</body>
</html>