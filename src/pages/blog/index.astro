---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(posts.map((post) => post.data.category))];
---
<BaseLayout title="Blog" description="Practical AI and automation guidance for African SMEs.">
  <section class="wrap header">
    <h1>The Blog</h1>
    <p>Practical automation and AI guidance for African SMEs — no jargon, no enterprise budgets.</p>
  </section>

  <section class="wrap whatsapp-list">
    <div class="whatsapp-list-inner">
      <div>
        <strong>Want new articles and kit tips as they drop?</strong>
        <p>Join the WhatsApp list â€” no spam, just useful stuff for Nigerian SMEs.</p>
      </div>
      <a class="btn" href="https://wa.me/2348144664481?text=Hi%2C%20I%27d%20like%20to%20join%20the%20LemonLogic%20Lab%20updates%20list" target="_blank" rel="noopener">Join on WhatsApp</a>
    </div>
  </section>

  {categories.length > 0 && (
    <section class="wrap categories">
      <div class="category-pills">
        <button class="pill active" data-filter="all">All</button>
        {categories.map((cat) => (
          <button class="pill" data-filter={cat}>{cat}</button>
        ))}
      </div>
    </section>
  )}

  <section class="wrap list">
    {posts.map((post) => (
      <a class="post-card" data-category={post.data.category} href={`/blog/${post.id}`}>
        <div class="post-meta">
          <span class="post-category">{post.data.category}</span>
          <span class="post-date">{post.data.pubDate.toLocaleDateString("en-GB", { month: "short", day: "numeric", year: "numeric" })}</span>
        </div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
      </a>
    ))}
    {posts.length === 0 && <p class="empty">First post coming soon.</p>}
    <p class="empty" id="no-results" style="display:none;">No posts in this category yet.</p>
  </section>
</BaseLayout>

<script>
  const pills = document.querySelectorAll<HTMLButtonElement>('.pill');
  const cards = document.querySelectorAll<HTMLAnchorElement>('.post-card');
  const noResults = document.getElementById('no-results');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const filter = pill.dataset.filter;

      pills.forEach((p) => p.classList.remove('active'));
      pill.classList.add('active');

      let visibleCount = 0;
      cards.forEach((card) => {
        const matches = filter === 'all' || card.dataset.category === filter;
        (card as HTMLElement).style.display = matches ? '' : 'none';
        if (matches) visibleCount++;
      });

      if (noResults) {
        noResults.style.display = visibleCount === 0 ? '' : 'none';
      }
    });
  });
</script>

<style>
  .header { padding: 56px 0 32px; }
  .header h1 { font-size: clamp(1.9rem, 4vw, 2.6rem); margin-bottom: 14px; }
  .header p { color: var(--muted); font-size: 1.05rem; margin: 0; max-width: 56ch; }

  .whatsapp-list { padding-bottom: 32px; }
  .whatsapp-list-inner {
    display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
    border: 1.5px solid var(--ink); border-radius: 8px; padding: 20px 24px;
    background: var(--lemon);
  }
  .whatsapp-list-inner strong { font-size: 1.02rem; display: block; margin-bottom: 4px; }
  .whatsapp-list-inner p { margin: 0; color: var(--ink); font-size: 0.92rem; }
  .whatsapp-list-inner .btn { flex-shrink: 0; background: #fff; }
  .whatsapp-list-inner .btn:hover { background: #f5f5f5; }

  .categories { padding-bottom: 24px; }
  .category-pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .pill {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem; font-weight: 600; color: var(--ink);
    border: 1.5px solid var(--gridline-dark); border-radius: 999px;
    padding: 6px 14px; background: #fff; cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .pill:hover { border-color: var(--ink); }
  .pill.active { background: var(--lemon); border-color: var(--ink); }

  .list { padding-bottom: 72px; display: flex; flex-direction: column; }
  .post-card {
    display: block; padding: 30px 0; border-top: 1px solid var(--gridline);
    text-decoration: none; color: var(--ink);
  }
  .post-card:last-child { border-bottom: 1px solid var(--gridline); }
  .post-meta { display: flex; align-items: center; gap: 12px; }
  .post-category {
    font-size: 0.78rem; font-weight: 700; color: var(--forest);
    text-transform: uppercase; letter-spacing: 0.03em;
  }
  .post-date { font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--muted); }
  .post-card h2 { font-size: 1.4rem; margin: 10px 0 10px; }
  .post-card p { color: var(--muted); font-size: 0.98rem; margin: 0; max-width: 62ch; }
  .empty { color: var(--muted); padding: 20px 0; }
</style>
