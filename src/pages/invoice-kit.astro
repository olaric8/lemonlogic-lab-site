        "priceCurrency": "NGN",
        "price": "4500",
        "availability": "https://schema.org/InStock",
        "seller": { "@type": "Organization", "name": "LemonLogic Lab" }
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Do I need Excel?",
          "acceptedAnswer": { "@type": "Answer", "text": "Excel or Google Sheets both work. No special software required." }
